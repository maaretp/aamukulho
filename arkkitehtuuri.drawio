<mxfile host="drawio">
  <diagram id="aamukulho-arkkitehtuuri" name="Arkkitehtuuri">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Otsikko -->
        <mxCell id="title" value="&lt;b&gt;Aamukulho – arkkitehtuuri&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Yhden tiedoston PWA ilman riippuvuuksia ja ilman palvelinlogiikkaa&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="50" as="geometry" />
        </mxCell>

